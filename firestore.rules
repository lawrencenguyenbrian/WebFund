rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Reusable admin check. Looks up the caller's own users/{uid} doc — only an
    // existing 'admin' passes. Note: get() inside rules is evaluated directly,
    // so it does not itself require read access on the users collection.
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // A user may self-assign only the two regular roles — never 'admin'.
    function isRegularRole(role) {
      return role == 'founder' || role == 'investor';
    }

    // Returns the field value, or null when the field is absent. Accessing a
    // missing field directly yields 'undefined' in rules, and comparing an
    // undefined value errors the whole rule (deny), so owner edits would be
    // rejected on projects that never stored these optional fields.
    function fieldOrNull(map, key) {
      return key in map ? map[key] : null;
    }

    // ── users ──
    // Any signed-in user may read any user doc (for founder/investor names).
    // A user creates/updates their own doc and may pick founder/investor, but
    // can never promote themselves to admin (or demote an existing admin).
    // Only an existing admin may grant the 'admin' role to someone.
    // Account deletion is self-service only (settings.js).
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if request.auth.uid == uid
        && isRegularRole(request.resource.data.role);
      allow update: if signedIn() && (
        isAdmin()
        || (
          request.auth.uid == uid
          && (
            request.resource.data.role == resource.data.role
            || (
              resource.data.role != 'admin'
              && isRegularRole(request.resource.data.role)
            )
          )
        )
      );
      allow delete: if request.auth.uid == uid;
    }

    // ── projects ──
    // Read: approved projects are public; owners and admins see every status.
    // Create: signed-in users may only create `pending` projects with
    //   `raised == 0` owned by themselves — no pre-approved or pre-funded
    //   documents. Admins may additionally create docs as-is, which is
    //   required by the admin "restore deleted project" flow.
    // Update: an owner may edit content, set/clear their own delete request,
    //   and signal a payout or feature request, but never change status,
    //   raised, userId, payoutStatus, feeAmount, featured, or featuredUntil.
    //   Admins may change status, adjust raised (on pledge confirmation),
    //   confirm payout (payoutStatus/feeAmount), approve feature listings
    //   (featured/featuredUntil), or clear a delete request (reject).
    // Delete: admins only — removal first copies the doc to deletedProjects.
    match /projects/{projectId} {
      allow read: if resource.data.status == 'approved'
        || (signedIn() && resource.data.userId == request.auth.uid)
        || isAdmin();
      allow create: if signedIn() && (
        isAdmin()
        || (
          request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.raised == 0
        )
      );
      allow update: if signedIn() && (
        isAdmin()
        || (
          resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.raised == resource.data.raised
          && request.resource.data.status == resource.data.status
          && fieldOrNull(request.resource.data, 'payoutStatus') == fieldOrNull(resource.data, 'payoutStatus')
          && fieldOrNull(request.resource.data, 'feeAmount') == fieldOrNull(resource.data, 'feeAmount')
          && fieldOrNull(request.resource.data, 'featured') == fieldOrNull(resource.data, 'featured')
          && fieldOrNull(request.resource.data, 'featuredUntil') == fieldOrNull(resource.data, 'featuredUntil')
        )
      );
      allow delete: if signedIn() && isAdmin();

      // Founder posts progress updates — owner writes only; readable by the
      // same audience as the parent project.
      match /updates/{updateId} {
        allow read: if get(/databases/$(database)/documents/projects/$(projectId)).data.status == 'approved'
          || (signedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid)
          || isAdmin();
        allow write: if signedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
      }
    }

    // ── deletedProjects (internal audit log) ──
    // Admin-only read, write, and delete. Not user-facing; keeps removals
    // traceable and reversible (admin restore re-creates the project doc).
    match /deletedProjects/{projectId} {
      allow read, write: if isAdmin();
    }

    // ── pledges ──
    // Read: users see only their own pledges; admins see all.
    // Create: signed-in users pledge for themselves, always as `pending`.
    // Update: only an admin may change status (confirm/reject); amount,
    //   projectId, and userId are immutable after creation.
    // Delete: never — pledges are a permanent record.
    match /pledges/{pledgeId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn() && isAdmin()
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.userId == resource.data.userId;
    }
  }
}
